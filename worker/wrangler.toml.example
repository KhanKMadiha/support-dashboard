name = "your-support-proxy"
main = "src/index.js"
compatibility_date = "2024-01-01"

# Copy to wrangler.toml and set your Notion KB database ID (with hyphens).
[vars]
NOTION_DATABASE_ID = "your-notion-database-id-here"

# Set secrets before deploy (never commit these):
#   cd worker
#   npx wrangler secret put ANTHROPIC_API_KEY
#   npx wrangler secret put NOTION_API_KEY
#
# Deploy:
#   npx wrangler deploy
